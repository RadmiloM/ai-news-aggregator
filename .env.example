PORT=3001
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
NEWS_CACHE_TTL_MS=600000

# Optional news API providers. RSS feeds work without these keys.
NEWS_API_KEY=
GNEWS_API_KEY=

# Optional Gemini summaries. The app falls back to the publisher description without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=100
GEMINI_PER_IP_PER_MINUTE=5
GEMINI_CONCURRENCY=2
GEMINI_QUEUE_LIMIT=20

# Override any RSS endpoint if a publisher changes its feed URL.
RSS_BBC_URL=https://feeds.bbci.co.uk/news/world/rss.xml
RSS_REUTERS_URL=https://www.reuters.com/rssFeed/world
RSS_ALJAZEERA_URL=https://www.aljazeera.com/xml/rss/all.xml
RSS_N1_URL=https://n1info.rs/feed/
RSS_B92_URL=https://www.b92.net/rss/vesti.xml
